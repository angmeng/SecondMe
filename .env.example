# SecondMe Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Environment
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Anthropic API Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# AutoMem Configuration
# ============================================
# AutoMem API endpoint (use localhost:8001 for local dev, automem:8001 for Docker)
AUTOMEM_API_URL=http://localhost:8001

# AutoMem API token (generate with: openssl rand -hex 32)
AUTOMEM_API_TOKEN=your_automem_api_token_here

# AutoMem admin token (generate with: openssl rand -hex 32)
AUTOMEM_ADMIN_TOKEN=your_automem_admin_token_here

# AutoMem's internal FalkorDB password
AUTOMEM_FALKORDB_PASSWORD=automem_default_password

# OpenAI API key for AutoMem embeddings and voice transcription (Whisper)
OPENAI_API_KEY=sk-...

# ============================================
# Redis Configuration
# ============================================
# Redis connection settings (defaults work for docker-compose setup)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Service Ports (for local development)
# ============================================
GATEWAY_PORT=3001
ORCHESTRATOR_PORT=3002
GRAPH_WORKER_PORT=3003
FRONTEND_PORT=3000

# Frontend URL for CORS (used by Gateway)
FRONTEND_URL=http://localhost:3000

# ============================================
# Security Configuration
# ============================================
# Session encryption key for AES-256 (generate with: openssl rand -base64 32)
SESSION_ENCRYPTION_KEY=your_encryption_key_here

# Enable audit logging for security events
ENABLE_AUDIT_LOG=true

# ============================================
# Pairing Mode Configuration (Phase 1)
# ============================================
# Enable pairing mode (require approval for new contacts)
PAIRING_ENABLED=true

# Auto-approve contacts that already have conversation history
PAIRING_AUTO_APPROVE_EXISTING=true

# Auto-reply to unknown/unapproved contacts
PAIRING_AUTO_REPLY_UNKNOWN=false

# Message to send to unknown contacts (if auto-reply is enabled)
PAIRING_AUTO_REPLY_MESSAGE=Hi! I don't recognize this number. Please let me know who you are.

# ============================================
# Telegram Configuration (Optional)
# ============================================
# Enable Telegram channel (default: false)
TELEGRAM_ENABLED=false

# Telegram bot token from @BotFather
# Get one by messaging @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# ============================================
# WhatsApp Configuration
# ============================================
# Master kill switch: when true, bot will not respond
MASTER_KILL_SWITCH=false

# Auto-pause on user message: when true, bot pauses when you send a message
AUTO_PAUSE_ON_USER_MESSAGE=true

# Sleep hours (bot won't respond during these hours)
SLEEP_START_HOUR=23
SLEEP_END_HOUR=7

# Rate limiting (messages per minute)
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# AI Behavior Configuration
# ============================================
# Default persona (casual_friend, professional_colleague, brainstorm_partner)
DEFAULT_PERSONA=casual_friend

# HTS (Human Typing Simulation) delay range in milliseconds
HTS_MIN_DELAY_MS=1000
HTS_MAX_DELAY_MS=3000

# Response creativity (temperature: 0.0-1.0)
AI_TEMPERATURE=0.7

# Maximum context retrieval depth for graph queries
GRAPH_MAX_CONTEXT_DEPTH=3

# ============================================
# Skill System Configuration (Phase 2)
# ============================================
# Enable skill-based context retrieval (vs legacy graphAndPersonaNode)
USE_SKILL_SYSTEM=false

# ============================================
# Conversation History Configuration
# ============================================
# Enable conversation history for RAG context
ENABLE_CONVERSATION_HISTORY=true

# Redis key prefix for conversation history
HISTORY_KEY_PREFIX=HISTORY:

# ============================================
# Media Processing Configuration (Phase 4)
# ============================================
# Enable voice transcription using OpenAI Whisper API
VOICE_TRANSCRIPTION_ENABLED=true

# Enable image understanding using Claude Vision
IMAGE_PROCESSING_ENABLED=true

# Maximum media file size in MB (default: 25, Whisper limit)
MEDIA_MAX_SIZE_MB=25

# Transcription timeout in milliseconds
TRANSCRIPTION_TIMEOUT_MS=30000

# Maximum payload size for Redis queue in MB (default: 10)
MAX_QUEUE_PAYLOAD_MB=10

# ============================================
# Text-to-Speech Configuration (Phase 4)
# ============================================
# ElevenLabs API key for voice synthesis
ELEVENLABS_API_KEY=

# Enable voice output (respond with voice to voice messages)
VOICE_OUTPUT_ENABLED=true

# ElevenLabs voice ID (optional, uses default if not set)
ELEVENLABS_VOICE_ID=

# Maximum characters to synthesize (cost control)
TTS_MAX_CHARACTERS=500

# TTS API timeout in milliseconds
TTS_TIMEOUT_MS=30000

# ============================================
# Enhanced RAG Configuration (Phase 5)
# ============================================
# Embedding provider: 'voyage' or 'openai' (default: voyage)
EMBEDDING_PROVIDER=voyage

# Voyage AI API key for embeddings (if using Voyage)
VOYAGE_API_KEY=

# Enable conversation indexing for semantic retrieval
CONVERSATION_INDEXING_ENABLED=false

# Enable retrieval fusion (multi-source context retrieval)
RETRIEVAL_FUSION_ENABLED=false

# Enable semantic RAG (requires AutoMem connection)
SEMANTIC_RAG_ENABLED=false
