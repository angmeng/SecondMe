{
  "name": "@secondme/cli",
  "version": "1.0.0",
  "description": "SecondMe Developer CLI - Setup, diagnostics, and management tools",
  "private": true,
  "type": "module",
  "bin": {
    "secondme": "./dist/bin/secondme.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx bin/secondme.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "inquirer": "^10.2.0",
    "ora": "^8.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
